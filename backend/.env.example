# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/newstrader

# Redis
REDIS_URL=redis://localhost:6379

# Claude AI
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Security
SECRET_KEY=your-super-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_HOSTS=["http://localhost:3000", "http://localhost:8000"]

# News Sources (RSS feeds)
NEWS_SOURCES=["https://feeds.reuters.com/reuters/businessNews", "https://feeds.bloomberg.com/markets/news.rss"]

# Trading symbols to monitor
TRADING_SYMBOLS=["SPY", "QQQ", "GLD", "CL=F", "GC=F", "ES=F", "NQ=F"]