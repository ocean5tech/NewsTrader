              "value": "={{ $json.response_data.added || 0 }}"
            },
            {
              "name": "stocks_updated",
              "value": "={{ $json.response_data.updated || 0 }}"
            },
            {
              "name": "stocks_total",
              "value": "={{ $json.response_data.total || 0 }}"
            }
          ]
        },
        "options": {}
      },
      "id": "execution-summary",
      "name": "执行摘要",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [
        1200,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "// 验证股票数据完整性\nconst testSymbols = ['000001', '000002', '600000', '300001'];\nconst results = [];\n\nfor (const symbol of testSymbols) {\n  try {\n    const response = await this.helpers.httpRequest({\n      method: 'GET',\n      url: `http://localhost:8000/api/v1/stocks/${symbol}`,\n      headers: {\n        'Accept': 'application/json'\n      }\n    });\n    \n    if (response && response.symbol === symbol) {\n      results.push({\n        symbol: symbol,\n        name: response.name,\n        status: 'found',\n        pinyin_short: response.name_pinyin_short\n      });\n    } else {\n      results.push({\n        symbol: symbol,\n        status: 'not_found'\n      });\n    }\n  } catch (error) {\n    results.push({\n      symbol: symbol, \n      status: 'error',\n      error: error.message\n    });\n  }\n  \n  // 避免请求过快\n  await new Promise(resolve => setTimeout(resolve, 100));\n}\n\nconst foundCount = results.filter(r => r.status === 'found').length;\nconst validationPassed = foundCount >= testSymbols.length * 0.5; // 至少50%可用\n\nconsole.log(`Stock validation: ${foundCount}/${testSymbols.length} stocks found`);\n\nreturn {\n  json: {\n    validation_passed: validationPassed,\n    found_count: foundCount,\n    total_tested: testSymbols.length,\n    test_results: results,\n    validation_time: new Date().toISOString()\n  }\n};"
      },
      "id": "validate-stock-data",
      "name": "验证股票数据",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1450,
        300
      ]
    }
