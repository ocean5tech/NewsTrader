      },
      "id": "update-stock-data",
      "name": "更新股票数据",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// 处理股票更新结果并生成报告\nconst response = $input.first().json;\n\nconst updateTime = new Date().toLocaleString('zh-CN', {\n  timeZone: 'Asia/Shanghai',\n  year: 'numeric',\n  month: '2-digit',\n  day: '2-digit',\n  hour: '2-digit',\n  minute: '2-digit',\n  second: '2-digit'\n});\n\nlet status = 'success';\nlet message = '';\n\nif (response && typeof response === 'object') {\n  const { added = 0, updated = 0, total = 0 } = response;\n  \n  if (total > 0) {\n    message = `股票数据更新成功！\\n` +\n              `- 新增股票: ${added} 只\\n` +\n              `- 更新股票: ${updated} 只\\n` +\n              `- 处理总数: ${total} 只\\n` +\n              `- 更新时间: ${updateTime}`;\n  } else {\n    status = 'warning';\n    message = `股票数据更新完成，但没有变化。\\n` +\n              `- 更新时间: ${updateTime}`;\n  }\n} else {\n  status = 'error';\n  message = `股票数据更新失败！\\n` +\n            `- 错误信息: ${JSON.stringify(response)}\\n` +\n            `- 更新时间: ${updateTime}`;\n}\n\n// 记录执行结果\nconsole.log(`Stock update ${status}: ${message}`);\n\nreturn {\n  json: {\n    status: status,\n    message: message,\n    update_time: updateTime,\n    response_data: response,\n    next_update: '下周日凌晨2:00'\n  }\n};"
      },
      "id": "process-update-result",
      "name": "处理更新结果",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "condition1",
              "leftValue": "={{ $json.status }}",
              "rightValue": "error",
              "operator": {
                "type": "string",
                "operation": "equals",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
